# Wally - Variables de Entorno
# Copia este archivo como .env y completa los valores

# --- Frontend (Vite) ---
# URL del proyecto Supabase (pública)
VITE_SUPABASE_URL=
# Clave anónima de Supabase (pública, va en el navegador)
VITE_SUPABASE_ANON_KEY=

# --- Edge Function Secrets (configurar en Supabase Dashboard) ---
# Service Role Key de Supabase (bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=
# Token del bot de Telegram
TELEGRAM_BOT_TOKEN=
# API Key de Gemini (fallback)
GEMINI_API_KEY=
# API Key de NVIDIA (principal, recomendada)
NVIDIA_API_KEY=
