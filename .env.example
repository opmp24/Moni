# PerJaus - Variables de Entorno
# Copia este archivo como .env y completa los valores

# --- Frontend (Vite) ---
# La URL del proyecto Supabase (pública)
VITE_SUPABASE_URL=
# La clave anónima de Supabase (pública, va en el navegador)
VITE_SUPABASE_ANON_KEY=

# --- Edge Function (Telegram Bot) ---
# La misma URL de Supabase
VITE_SUPABASE_URL=
# Service Role Key (NUNCA poner en frontend)
SUPABASE_SERVICE_ROLE_KEY=
# Token del bot de Telegram
TELEGRAM_BOT_TOKEN=
# API Key de Gemini
GEMINI_API_KEY=
